<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net6.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Google.Protobuf" Version="3.27.3" />
    <PackageReference Include="Grpc.Net.Client" Version="2.64.0" />
    <PackageReference Include="Grpc.Tools" Version="2.64.0" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <Protobuf Include="..\..\..\..\protocol\proto\gameagent.proto" GrpcServices="Client" />
    <Compile Include="..\..\src\Runtime\CapabilityCatalog.cs" Link="CapabilityCatalog.cs" />
    <Compile Include="..\..\src\Runtime\ProtocolMapper.Core.cs" Link="ProtocolMapper.Core.cs" />
    <Compile Include="..\..\src\Runtime\RuntimeWorldScope.cs" Link="RuntimeWorldScope.cs" />
    <Compile Include="..\..\src\State\ProbeObservation.cs" Link="ProbeObservation.cs" />
  </ItemGroup>
</Project>
